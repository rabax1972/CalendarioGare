<?xml version="1.0" encoding="utf-8"?>
<!--
  Regole per IIS (hosting Windows di Aruba, cartella /calendariogare del dominio).
  - Tipi .webmanifest, .webp e .ics: senza, IIS risponde 404 al manifest della PWA, ai loghi e ai calendari delle squadre. Il "remove" evita l'errore di tipo
    duplicato sui server che li conoscono già.
  - Aggiornamento automatico (api/_pubblicazione.php): il PHP può scrivere solo in mdb-database, quindi i file aggiornati dalla
    GitHub Action stanno in mdb-database/calendariogare/sito/ e, quando esistono, li serve api/sito.php al posto di quelli statici.
  Se l'app cambia cartella, cambiano anche gli URL "/calendariogare/..." qui sotto e ARUBA_URL in scripts/pubblica-aruba.ts.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".ics" />
      <mimeMap fileExtension=".ics" mimeType="text/calendar" />
    </staticContent>
    <rewrite>
      <rules>
        <rule name="Calendario aggiornamenti: pagina" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}mdb-database\calendariogare\sito\index.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/calendariogare/api/sito.php?f=index.html" />
        </rule>
        <rule name="Calendario aggiornamenti: file" stopProcessing="true">
          <match url="^.*[^/]$" />
          <conditions>
            <add input="{R:0}" pattern="^api/" negate="true" />
            <add input="{APPL_PHYSICAL_PATH}mdb-database\calendariogare\sito\{R:0}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="/calendariogare/api/sito.php?f={R:0}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
