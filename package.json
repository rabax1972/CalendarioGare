{
  "name": "calendario-gare-parma",
  "private": true,
  "version": "0.1.0",
  "description": "PWA con calendari e risultati della pallavolo di Parma e provincia",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "scrape": "tsx scraper/src/main.ts",
    "pubblica:aruba": "tsx scripts/pubblica-aruba.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "pwa-assets-generator",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "cheerio": "^1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
